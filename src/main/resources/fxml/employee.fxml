<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F5F7FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ================= TOP ================= -->
    <top>
        <AnchorPane prefHeight="70" style="-fx-background-color: #111827;">
            <children>
                <Label layoutX="20" layoutY="20" style="-fx-text-fill: white;                               -fx-font-size: 20px;                               -fx-font-weight: bold;" text="OptiFlow" />
            </children>
        </AnchorPane>
    </top>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="160" spacing="8" style="-fx-background-color: #111827; -fx-padding: 15;">

            <!-- LOGO / TITLE SPACE -->
            <Label style="-fx-text-fill: #6B7280;                       -fx-font-size: 11px;                       -fx-font-weight: bold;" text="MENU" />

            <!-- DASHBOARD (ACTIVE) -->
            <Button maxWidth="Infinity" style="-fx-background-color: #374151;                        -fx-text-fill: white;                        -fx-alignment: CENTER_LEFT;                        -fx-padding: 10 15;                        -fx-background-radius: 8;" text="Dashboard" />

            <!-- OTHERS -->
            <Button maxWidth="Infinity" style="-fx-background-color: transparent;                        -fx-text-fill: #D1D5DB;                        -fx-alignment: CENTER_LEFT;                        -fx-padding: 10 15;                        -fx-background-radius: 8;" text="Analytics" />

            <Button maxWidth="Infinity" style="-fx-background-color: transparent;                        -fx-text-fill: #D1D5DB;                        -fx-alignment: CENTER_LEFT;                        -fx-padding: 10 15;                        -fx-background-radius: 8;" text="Reports" />

            <Button maxWidth="Infinity" style="-fx-background-color: transparent;                        -fx-text-fill: #D1D5DB;                        -fx-alignment: CENTER_LEFT;                        -fx-padding: 10 15;                        -fx-background-radius: 8;" text="Settings" />

            <Button maxWidth="Infinity" style="-fx-background-color: transparent;                        -fx-text-fill: #D1D5DB;                        -fx-alignment: CENTER_LEFT;                        -fx-padding: 10 15;                        -fx-background-radius: 8;" text="Help" />

            <!-- SPACER -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- LOGOUT -->
            <Button maxWidth="Infinity" style="-fx-background-color: transparent;                        -fx-text-fill: #EF4444;                        -fx-alignment: CENTER_LEFT;                        -fx-padding: 10 15;                        -fx-background-radius: 8;" text="Logout" />

        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #F8FAFC;">

            <content>
                <VBox spacing="20" style="-fx-padding: 20;">

                    <!-- TITLE -->
                    <Label text="Employee Workload (Gantt Chart)"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                    <!-- HEADER ROW -->
                    <HBox spacing="5"
                          style="-fx-background-color: #E5E7EB;
                         -fx-padding: 10;
                         -fx-background-radius: 6;">

                        <Label text="Employee"
                               prefWidth="120"
                               style="-fx-font-weight: bold;"/>

                        <!-- DYNAMIC DATES -->
                        <HBox fx:id="dateHeader" spacing="2"/>
                    </HBox>

                    <!-- EMPLOYEE ROWS -->
                    <VBox fx:id="ganttContainer" spacing="15"/>

                </VBox>
            </content>

        </ScrollPane>
    </center>



</BorderPane>
