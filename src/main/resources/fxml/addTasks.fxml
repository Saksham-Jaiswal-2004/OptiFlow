<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F5F7FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ================= TOP ================= -->
    <top>
        <AnchorPane prefHeight="68.0" style="-fx-background-color: #111827;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="OptiFlow" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />

                <Label style="-fx-background-color: linear-gradient(to right, #8e2de2, #c471ed);                                -fx-background-radius: 50;                                -fx-text-fill: white;                                -fx-font-weight: bold;" text="Employee" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                    <padding>
                        <Insets bottom="2.0" left="8.0" right="8.0" top="2.0" />
                    </padding>
                </Label>
            </children>
        </AnchorPane>
    </top>

    <!-- ================= CENTER ================= -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #1F2937;">
            <content>

                <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30;">

                    <!-- FORM CARD -->
                    <VBox spacing="18" style="-fx-background-color: #1F2937;                                  -fx-padding: 25;                                  -fx-background-radius: 12;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 4);">

                        <!-- TITLE -->
                        <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Create New Task" />

                        <!-- TASK NAME -->
                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #D1D5DB;" text="Task Name" />
                            <TextField fx:id="taskNameField" promptText="Enter task name" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-background-radius: 6;" />
                        </VBox>

                        <!-- SKILLS -->
                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #D1D5DB;" text="Skills Required" />
                            <ComboBox fx:id="skillsDropdown" prefWidth="250" promptText="Select Skills" style="-fx-background-color: #4b5563; -fx-text-fill: white;" />
                        </VBox>

                        <!-- EMPLOYEE + AUTO ASSIGN (FIXED) -->
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <children>

                                <!-- EMPLOYEE -->
                                <VBox spacing="5">
                                    <Label style="-fx-text-fill: #D1D5DB;" text="Select Employee" />
                                    <ComboBox fx:id="employeeDropdown" prefWidth="250" promptText="Choose Employee" style="-fx-background-color: #4b5563; -fx-text-fill: white;" />
                                </VBox>

                                <!-- PUSH BUTTON RIGHT -->
                                <Region HBox.hgrow="ALWAYS" />

                                <!-- AUTO ASSIGN -->
                                <Button onAction="#handleAutoAssign" prefHeight="35" style="-fx-background-color: linear-gradient(to right, #8e2de2, #c471ed);                                                -fx-text-fill: white;                                                -fx-font-weight: bold;                                                -fx-background-radius: 8;" text="Auto Assign" />

                            </children>
                        </HBox>

                        <!-- DEADLINE -->
                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #D1D5DB;" text="Deadline" />
                            <DatePicker fx:id="deadlinePicker" style="-fx-background-color: #4b5563;                                                -fx-control-inner-background: #4b5563;" />
                        </VBox>

                        <!-- DESCRIPTION -->
                        <VBox spacing="5">
                            <Label style="-fx-text-fill: #D1D5DB;" text="Task Description" />
                            <TextArea fx:id="descriptionArea" prefHeight="80" promptText="Write task details..." style="-fx-background-color: #4b5563;                                              -fx-text-fill: white;                                              -fx-control-inner-background: #4b5563;                                              -fx-background-radius: 6;" wrapText="true" />
                        </VBox>

                        <!-- CREATE BUTTON -->
                        <Button onAction="#handleCreateTask" prefHeight="35" style="-fx-background-color: linear-gradient(to right, #8e2de2, #c471ed);                                        -fx-text-fill: white;                                        -fx-font-weight: bold;                                        -fx-background-radius: 8;" text="Create Task" />

                    </VBox>

                </VBox>

            </content>
        </ScrollPane>
    </center>

</BorderPane>
