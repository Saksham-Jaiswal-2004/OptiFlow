<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #F5F7FA;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.optiflow.controllers.DashboardController">

    <top>
        <AnchorPane prefHeight="70" style="-fx-background-color: #111827;">
            <children>
                <Label layoutX="20" layoutY="20"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"
                       text="OptiFlow" />

                <Label fx:id="badge"
                       layoutX="800"
                       layoutY="25" />
            </children>
        </AnchorPane>
    </top>

    <left>
        <VBox fx:id="sidebarContainer"/>
    </left>


    <center>
        <ScrollPane fitToWidth="true"
                    pannable="true"
                    vbarPolicy="ALWAYS"
                    style="-fx-background: #1F2937;">

            <content>
                <VBox spacing="20" style="-fx-padding: 20;">


                    <Label text="Welcome"
                           style="-fx-font-size: 30px; -fx-font-weight: bold;" />


                    <HBox fx:id="statsContainer"
                          spacing="20"
                          style="-fx-padding: 10 20 10 20;" />


                    <VBox spacing="15">


                        <Label fx:id="logsHeader"
                               style="-fx-font-size: 24px; -fx-font-weight: bold;" />


                        <VBox fx:id="logsContainer"
                              spacing="15"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>