<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="20"
      style="-fx-background-color: #111827;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1">

    <!-- Padding -->
    <padding>
        <Insets top="50" right="40" bottom="50" left="40" />
    </padding>

    <!-- CARD -->
    <VBox alignment="CENTER"
          spacing="18"
          style="-fx-background-color: #1F2937;
                 -fx-padding: 30;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15, 0.2, 0, 5);">

        <!-- TITLE -->
        <Label text="Create Account"
               style="-fx-text-fill: white;
                      -fx-font-size: 24px;
                      -fx-font-weight: bold;" />

        <!-- USERNAME -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Username"
                   style="-fx-text-fill: #D1D5DB; -fx-font-weight: bold;" />

            <TextField prefWidth="260"
                       promptText="Enter username"
                       style="-fx-background-color: #374151;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #9CA3AF;
                              -fx-background-radius: 8;" />
        </VBox>

        <!-- EMAIL -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Email"
                   style="-fx-text-fill: #D1D5DB; -fx-font-weight: bold;" />

            <TextField prefWidth="260"
                       promptText="Enter email"
                       style="-fx-background-color: #374151;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #9CA3AF;
                              -fx-background-radius: 8;" />
        </VBox>

        <!-- PASSWORD -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Password"
                   style="-fx-text-fill: #D1D5DB; -fx-font-weight: bold;" />

            <PasswordField prefWidth="260"
                           promptText="Enter password"
                           style="-fx-background-color: #374151;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #9CA3AF;
                                  -fx-background-radius: 8;" />
        </VBox>

        <!-- CONFIRM PASSWORD -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Confirm Password"
                   style="-fx-text-fill: #D1D5DB; -fx-font-weight: bold;" />

            <PasswordField prefWidth="260"
                           promptText="Re-enter password"
                           style="-fx-background-color: #374151;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #9CA3AF;
                                  -fx-background-radius: 8;" />
        </VBox>

        <!-- REGISTER BUTTON -->
        <Button text="Register"
                prefWidth="260"
                style="-fx-background-color: linear-gradient(to right, #8e2de2, #c471ed);
                       -fx-cursor: hand;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;" />

        <!-- LOGIN LINK -->
        <HBox spacing="5" alignment="CENTER">
            <Label text="Already have an account?"
                   style="-fx-text-fill: #9CA3AF;" />

            <Hyperlink text="Login"
                       style="-fx-text-fill: #8e2de2; -fx-font-weight: bold;" />
        </HBox>

    </VBox>

</VBox>