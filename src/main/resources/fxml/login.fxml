<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: #111827;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.optiflow.controllers.LoginController">

    <padding>
        <Insets bottom="50" left="40" right="40" top="50" />
    </padding>

    <!-- CARD -->
    <VBox alignment="CENTER" spacing="18" style="-fx-background-color: #1F2937;                  -fx-padding: 30;                  -fx-background-radius: 12;                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15, 0.2, 0, 5);">

        <!-- TITLE -->
        <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Welcome Back!" />

        <!-- USERNAME -->
        <VBox alignment="CENTER_LEFT" spacing="5">
            <Label style="-fx-text-fill: #D1D5DB; -fx-font-weight: bold;" text="Email" />
            <TextField fx:id="emailField" prefWidth="260" promptText="Enter your email" style="-fx-background-color: #374151; -fx-text-fill: white;" />
        </VBox>

        <!-- PASSWORD -->
        <VBox alignment="CENTER_LEFT" spacing="5">
            <Label style="-fx-text-fill: #D1D5DB; -fx-font-weight: bold;" text="Password" />
            <PasswordField fx:id="passwordField" prefWidth="260" promptText="Enter your password" style="-fx-background-color: #374151; -fx-text-fill: white;" />
        </VBox>
        <Label fx:id="LoginerrorLabel"
               textFill="red"
               style="-fx-font-size: 12px; -fx-font-weight: bold"
               wrapText="true" />
        <!-- LOGIN BUTTON -->
        <Button onAction="#handleLogin" prefWidth="260" style="-fx-background-color: linear-gradient(to right, #8e2de2, #c471ed);                        -fx-cursor: hand;                        -fx-text-fill: white;                        -fx-font-weight: bold;                        -fx-background-radius: 8;" text="Login" />

        <!-- SIGNUP -->
        <HBox alignment="CENTER" spacing="5">
            <Label style="-fx-text-fill: #9CA3AF;" text="Don't have an account?" />
            <Hyperlink onAction="#goToRegister" style="-fx-text-fill: #8e2de2; -fx-font-weight: bold;" text="Sign Up" />
        </HBox>

    </VBox>
</VBox>
