<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #F5F7FA;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.optiflow.controllers.ViewTasksController">

    <!-- ================= TOP ================= -->
    <top>
        <AnchorPane prefHeight="70.0" style="-fx-background-color: #111827;">
            <children>

                <!-- APP NAME -->
                <Label text="OptiFlow"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"
                       AnchorPane.leftAnchor="20.0"
                       AnchorPane.topAnchor="20.0"/>

                <!-- ROLE BADGE -->
                <Label fx:id="roleBadge"
                       style="-fx-background-radius: 50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 12;"
                       AnchorPane.rightAnchor="120.0"
                       AnchorPane.topAnchor="20.0"/>

                <!-- CLOSE BUTTON -->
                <Button fx:id="closeBtn"
                        text="✕"
                        onAction="#handleClose"
                        style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold;"
                        AnchorPane.rightAnchor="20.0"
                        AnchorPane.topAnchor="20.0"/>

            </children>
        </AnchorPane>
    </top>

    <!-- ================= CENTER ================= -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
            <content>

                <VBox spacing="20"
                      style="-fx-background-color: #1F2937; -fx-padding: 25; -fx-background-radius: 10;">

                    <!-- ===== HEADER ===== -->
                    <VBox spacing="10">

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="taskTitle"
                                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                            <Label text="|"
                                   style="-fx-text-fill: #9CA3AF;"/>

                            <Label fx:id="projectName"
                                   style="-fx-text-fill: #D1D5DB; -fx-font-size: 16px;"/>
                        </HBox>

                        <Label fx:id="statusBadge"
                               style="-fx-background-radius: 50; -fx-text-fill: white; -fx-padding: 5 12;"/>

                    </VBox>

                    <Separator style="-fx-background-color: #374151;"/>

                    <!-- ===== EMPLOYEE INFO ===== -->
                    <VBox spacing="10">

                        <HBox spacing="15">
                            <Label text="Employee:"
                                   style="-fx-text-fill: #9CA3AF;"/>
                            <Label fx:id="employeeName"
                                   style="-fx-text-fill: white;"/>

                            <Label text="ID:"
                                   style="-fx-text-fill: #9CA3AF;"/>
                            <Label fx:id="employeeId"
                                   style="-fx-text-fill: white;"/>
                        </HBox>

                        <HBox spacing="10">
                            <Label text="Skills:"
                                   style="-fx-text-fill: #9CA3AF;"/>
                            <Label fx:id="skills"
                                   style="-fx-text-fill: white;"/>
                        </HBox>

                    </VBox>

                    <Separator style="-fx-background-color: #374151;"/>

                    <!-- ===== DATES & HOURS ===== -->
                    <HBox spacing="60">

                        <!-- LEFT -->
                        <VBox spacing="10">
                            <HBox spacing="8">
                                <Label text="Start Date:"
                                       style="-fx-text-fill: #9CA3AF;"/>
                                <Label fx:id="startDate"
                                       style="-fx-text-fill: white;"/>
                            </HBox>

                            <HBox spacing="8">
                                <Label text="Deadline:"
                                       style="-fx-text-fill: #9CA3AF;"/>
                                <Label fx:id="deadline"
                                       style="-fx-text-fill: white;"/>
                            </HBox>
                        </VBox>

                        <!-- RIGHT -->
                        <VBox spacing="10">
                            <HBox spacing="8">
                                <Label text="Estimated Hours:"
                                       style="-fx-text-fill: #9CA3AF;"/>
                                <Label fx:id="estimatedHours"
                                       style="-fx-text-fill: white;"/>
                            </HBox>

                            <HBox spacing="8">
                                <Label text="Current Hours:"
                                       style="-fx-text-fill: #9CA3AF;"/>
                                <Label fx:id="currentHours"
                                       style="-fx-text-fill: white;"/>
                            </HBox>
                        </VBox>

                    </HBox>

                    <Separator style="-fx-background-color: #374151;"/>

                    <!-- ===== DESCRIPTION ===== -->
                    <VBox spacing="8">
                        <Label text="Task Description"

                               style="-fx-text-fill: #9CA3AF;"/>

                        <Label fx:id="description"
                               wrapText="true"
                               style="-fx-text-fill: white; -fx-background-color: #374151; -fx-padding: 10; -fx-background-radius: 6;"/>
                    </VBox>

                </VBox>

            </content>
        </ScrollPane>
    </center>

</BorderPane>