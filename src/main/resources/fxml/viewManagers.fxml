<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F5F7FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ================= TOP ================= -->
    <top>
        <AnchorPane prefHeight="68.0" style="-fx-background-color: #111827;">
            <children>
                <Label text="OptiFlow"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"
                       AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0"/>

                <Label text="Manager"
                       style="-fx-background-color: linear-gradient(to right, #8e2de2, #c471ed);
                              -fx-background-radius: 50;
                              -fx-text-fill: white;
                              -fx-font-weight: bold;"
                       AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                    <padding>
                        <Insets bottom="2" left="10" right="10" top="2"/>
                    </padding>
                </Label>
            </children>
        </AnchorPane>
    </top>

    <!-- ================= CENTER ================= -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #1F2937;">
            <content>

                <VBox spacing="20"
                      style="-fx-background-color: #1F2937;
                             -fx-padding: 25;
                             -fx-background-radius: 12;">

                    <!-- HEADER -->
                    <VBox spacing="10">

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <children>
                                <Label text="Manager ABC"
                                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                                <Separator orientation="VERTICAL" prefHeight="25"/>

                                <Label text="Project Alpha"
                                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <!-- STATUS -->
                        <Label text="In Progress"
                               style="-fx-background-color: linear-gradient(to right, #8e2de2, #c471ed);
                                      -fx-background-radius: 50;
                                      -fx-text-fill: white;
                                      -fx-font-weight: bold;">
                            <padding>
                                <Insets bottom="2" left="12" right="12" top="2"/>
                            </padding>
                        </Label>

                    </VBox>

                    <!-- MANAGER INFO -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <children>
                            <Label text="Manager ID:" style="-fx-text-fill: #D1D5DB;"/>
                            <Label text="John Doe" style="-fx-text-fill: white;"/>

                            <Separator orientation="VERTICAL" prefHeight="20"/>

                            <Label text="Employee ID:" style="-fx-text-fill: #D1D5DB;"/>
                            <Label text="EMP12345" style="-fx-text-fill: white;"/>
                        </children>
                    </HBox>

                    <!-- DATES -->
                    <HBox spacing="40">
                        <children>
                            <HBox spacing="8">
                                <Label text="Start Date:" style="-fx-text-fill: #D1D5DB;"/>
                                <Label text="01 Jan 2026" style="-fx-text-fill: white;"/>
                            </HBox>

                            <HBox spacing="8">
                                <Label text="End Date:" style="-fx-text-fill: #D1D5DB;"/>
                                <Label text="30 Jun 2026" style="-fx-text-fill: white;"/>
                            </HBox>
                        </children>
                    </HBox>

                    <!-- DESCRIPTION -->
                    <VBox spacing="5">
                        <Label text="Project Description" style="-fx-text-fill: #D1D5DB;"/>
                        <TextArea prefHeight="70"
                                  wrapText="true"
                                  style="-fx-control-inner-background: #374151;
                                         -fx-text-fill: white;
                                         -fx-background-radius: 6;"/>
                    </VBox>

                    <!-- ================= EMPLOYEES SECTION ================= -->
                    <VBox spacing="15">

                        <!-- HEADING -->
                        <Label text="Employees"
                               style="-fx-text-fill: white;
                                      -fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <!-- EMPLOYEE CARD 1 -->
                        <VBox spacing="10"
                              style="-fx-background-color: #374151;
                                     -fx-padding: 15;
                                     -fx-background-radius: 10;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0.2, 0, 3);">

                            <HBox alignment="CENTER_LEFT" spacing="20">
                                <children>

                                    <!-- NAME + ID -->
                                    <VBox spacing="5">
                                        <Label text="Ram Sharma"
                                               style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                                        <Label text="ID: 787878"
                                               style="-fx-text-fill: #D1D5DB; -fx-font-size: 11px;"/>
                                    </VBox>

                                    <!-- SKILL -->
                                    <VBox spacing="5">
                                        <Label text="Skill"
                                               style="-fx-text-fill: #D1D5DB; -fx-font-size: 11px;"/>
                                        <Label text="AI"
                                               style="-fx-text-fill: white;"/>
                                    </VBox>

                                    <!-- TASK -->
                                    <VBox spacing="5">
                                        <Label text="Task"
                                               style="-fx-text-fill: #D1D5DB; -fx-font-size: 11px;"/>
                                        <Label text="Task Astro"
                                               style="-fx-text-fill: white;"/>
                                    </VBox>

                                </children>
                            </HBox>

                        </VBox>

                        <!-- EMPLOYEE CARD 2 -->
                        <VBox spacing="10"
                              style="-fx-background-color: #374151;
                                     -fx-padding: 15;
                                     -fx-background-radius: 10;">

                            <HBox alignment="CENTER_LEFT" spacing="20">
                                <children>

                                    <VBox spacing="5">
                                        <Label text="Anita Verma"
                                               style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                                        <Label text="ID: 989898"
                                               style="-fx-text-fill: #D1D5DB; -fx-font-size: 11px;"/>
                                    </VBox>

                                    <VBox spacing="5">
                                        <Label text="Skill"
                                               style="-fx-text-fill: #D1D5DB; -fx-font-size: 11px;"/>
                                        <Label text="Frontend"
                                               style="-fx-text-fill: white;"/>
                                    </VBox>

                                    <VBox spacing="5">
                                        <Label text="Task"
                                               style="-fx-text-fill: #D1D5DB; -fx-font-size: 11px;"/>
                                        <Label text="UI Design"
                                               style="-fx-text-fill: white;"/>
                                    </VBox>

                                </children>
                            </HBox>

                        </VBox>

                    </VBox>

                </VBox>

            </content>
        </ScrollPane>
    </center>

</BorderPane>