<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #F5F7FA;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.optiflow.controllers.TaskController">

    <!-- ================= TOP ================= -->
    <top>
        <AnchorPane prefHeight="70" style="-fx-background-color: #111827;">
            <children>
                <Label layoutX="20" layoutY="20"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"
                       text="OptiFlow" />

                <!-- 🔥 ROLE BADGE -->
                <Label fx:id="roleBadge"
                       layoutX="820" layoutY="22"
                       style="-fx-background-color: linear-gradient(to right, #8e2de2, #c471ed);
                              -fx-background-radius: 50;
                              -fx-text-fill: white;
                              -fx-font-weight: bold;">
                    <padding>
                        <Insets bottom="2" left="8" right="8" top="2"/>
                    </padding>
                </Label>
            </children>
        </AnchorPane>
    </top>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="160" spacing="8"
              style="-fx-background-color: #111827; -fx-padding: 15;">

            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-font-weight: bold;"
                   text="MENU" />

            <Button fx:id="analyticsBtn"
                    text="Analytics"
                    onAction="#handleAnalytics"
                    maxWidth="Infinity"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-background-radius: 8;" />

            <Button text="Project" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #D1D5DB; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" />

            <Button text="Tasks" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #D1D5DB; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" />

            <Button text="Employees" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #D1D5DB; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" />

            <Region VBox.vgrow="ALWAYS" />

            <Button text="Logout" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #EF4444; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" />
        </VBox>
    </left>

    <!-- ================= MAIN ================= -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #1F2937;">
            <content>

                <VBox spacing="20" style="-fx-padding: 20;">

                    <!-- TITLE -->
                    <Label text="Tasks"
                           style="-fx-font-size: 30px; -fx-font-weight: bold;" />

                    <Label text="Here’s your task overview"
                           style="-fx-text-fill: #6B7280;" />

                    <!-- ================= STATS ================= -->
                    <HBox fx:id="statsContainer" spacing="20"/>

                    <!-- ================= HEADER ================= -->
                    <HBox alignment="CENTER_LEFT" spacing="15">

                        <Label text="Tasks"
                               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- 🔥 ADD BUTTON -->
                        <Button fx:id="addBtn"
                                text="+ Add"
                                style="-fx-background-color: linear-gradient(to right, #05a857, #6EE7B7);
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;" />
                    </HBox>

                    <!-- 🔥 DYNAMIC TASK LIST -->
                    <VBox fx:id="tasksContainer" spacing="15"/>

                    <!-- 🔥 EXPORT BUTTON -->
                    <Button fx:id="exportBtn"
                            onAction="#handleExport"
                            text="Export"
                            style="-fx-background-color: linear-gradient(to right, #1E3A8A, #3B82F6);
                                   -fx-text-fill: white;">
                        <VBox.margin>
                            <Insets left="650.0"/>
                        </VBox.margin>
                    </Button>

                </VBox>

            </content>
        </ScrollPane>
    </center>

</BorderPane>