<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F5F7FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ================= TOP ================= -->
    <top>
        <AnchorPane prefHeight="70" style="-fx-background-color: #111827;">
            <children>
                <Label layoutX="20" layoutY="20" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="OptiFlow" />

                <Label layoutX="841" layoutY="22" style="-fx-background-color: linear-gradient(to right, #8e2de2, #c471ed);                               -fx-background-radius: 50;                               -fx-text-fill: white;                               -fx-font-weight: bold;" text="Employee">
                    <padding>
                        <Insets bottom="2" left="8" right="8" top="2" />
                    </padding>
                </Label>
            </children>
        </AnchorPane>
    </top>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="160" spacing="8" style="-fx-background-color: #111827; -fx-padding: 15;">

            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-font-weight: bold;" text="MENU" />

            <Button maxWidth="Infinity" style="-fx-background-color: #374151; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-background-radius: 8;" text="Dashboard" />

            <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #D1D5DB; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="Managers" />

            <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #D1D5DB; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="Tasks" />

            <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #D1D5DB; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="Employees" />

            <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #D1D5DB; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="Help" />

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #EF4444; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="Logout" />
        </VBox>
    </left>

    <!-- ================= MAIN ================= -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #1F2937;">
            <content>

                <VBox spacing="20" style="-fx-padding: 20;">

                    <!-- TITLE -->
                    <Label style="-fx-font-size: 30px; -fx-font-weight: bold;" text="Tasks" />

                    <Label style="-fx-text-fill: #6B7280;" text="Here’s your task overview" />

                    <!-- ================= STATS ================= -->
                    <HBox spacing="20">

                        <VBox style="-fx-background-radius: 12; -fx-padding: 18; -fx-background-color: linear-gradient(to right, #1E3A8A, #3B82F6);" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: white;" text="Total Tasks" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="10" />
                        </VBox>

                        <VBox style="-fx-background-radius: 12; -fx-padding: 18; -fx-background-color: linear-gradient(to right, #065F46, #10B981);" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: white;" text="Active Tasks" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="5" />
                        </VBox>

                        <VBox style="-fx-background-radius: 12; -fx-padding: 18; -fx-background-color: linear-gradient(to right, #92400E, #F59E0B);" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: white;" text="Completed Tasks" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="50" />
                        </VBox>

                        <VBox style="-fx-background-radius: 12; -fx-padding: 18; -fx-background-color: linear-gradient(to right, #7F1D1D, #EF4444);" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: white;" text="Pending Tasks" />
                            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="10" />
                        </VBox>

                    </HBox>

                    <!-- ================= FILTER BAR ================= -->
                    <HBox alignment="CENTER_LEFT" spacing="15">

                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Tasks" />

                        <ComboBox fx:id="taskFilterDropdown" prefWidth="200" promptText="Select Type" style="-fx-background-color: #374151; -fx-text-fill: white;" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button style="-fx-background-color: linear-gradient(to right, #05a857, #6EE7B7);                                        -fx-text-fill: white;                                        -fx-font-weight: bold;" text="+ Add" />

                    </HBox>

                    <!-- ================= TASK CARD ================= -->
                    <VBox spacing="10" style="-fx-background-color: #374151;                                  -fx-padding: 15;                                  -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.2, 0, 4);">

                        <HBox alignment="CENTER_LEFT">
                            <children>
                        <HBox prefHeight="26.0" prefWidth="185.0">
                           <children>
      
                                      <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Task Alpha" textFill="WHITE" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label prefHeight="29.0" prefWidth="67.0" style="-fx-background-color: linear-gradient(to right, #92400E, #F59E0B); -fx-background-radius: 50; -fx-text-fill: white; -fx-font-weight: bold;" text="Assigned">
                                 <padding>
                                    <Insets bottom="2" left="8" right="8" top="2" />
                                 </padding>
                                 <HBox.margin>
                                    <Insets />
                                 </HBox.margin>
                              </Label>
                           </children>
                        </HBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <Button style="-fx-background-color: linear-gradient(to right, #1E3A8A, #3B82F6);                                                -fx-text-fill: white;" text="Edit" />

                            </children>
                        </HBox>

                        <Label style="-fx-text-fill: #6B7280;" text="This is a sample task description." wrapText="true" />

                        <Button style="-fx-background-color: linear-gradient(to right, #065F46, #10B981); -fx-text-fill: white;" text="Open Task" />

                    </VBox>

                </VBox>

            </content>
        </ScrollPane>
    </center>

</BorderPane>
