<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.optiflow.controllers.EmployeeListController"
      spacing="14"
      styleClass="proj-root"
      stylesheets="@../css/style.css">

    <VBox spacing="3">
        <Label text="Employee List" styleClass="proj-title"/>
        <Label text="Overview of team capacity, expertise, and performance" styleClass="proj-subtitle"/>
    </VBox>

    <VBox spacing="10" styleClass="proj-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="employeeTable" styleClass="proj-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="180"/>
                <TableColumn fx:id="roleColumn" text="Role" prefWidth="150"/>
                <TableColumn fx:id="skillsColumn" text="Skills" prefWidth="280"/>
                <TableColumn fx:id="workloadColumn" text="Workload" prefWidth="150"/>
                <TableColumn fx:id="performanceColumn" text="Performance" prefWidth="170"/>
            </columns>

            <placeholder>
                <Label text="No employee records available" styleClass="proj-empty"/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
