<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.optiflow.controllers.EmployeeListController"
      spacing="14"
      styleClass="proj-root"
      stylesheets="@../css/style.css">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Employee List" styleClass="proj-title"/>
            <Label text="Overview of team capacity, expertise, and performance" styleClass="proj-subtitle"/>
        </VBox>
        <Button fx:id="exportBtn" text="Export" styleClass="glass-btn" onAction="#handleExport"/>
    </HBox>

    <VBox spacing="10" styleClass="proj-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="employeeTable" styleClass="proj-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="userIdColumn" text="User-Id" prefWidth="110"/>
                <TableColumn fx:id="empIdColumn" text="Emp-Id" prefWidth="110"/>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="170"/>
                <TableColumn fx:id="designationColumn" text="Designation" prefWidth="150"/>
                <TableColumn fx:id="departmentColumn" text="Department" prefWidth="150"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
                <TableColumn fx:id="weeklyCapacityColumn" text="Weekly Capacity" prefWidth="140"/>
            </columns>

            <placeholder>
                <Label text="No employee records available" styleClass="proj-empty"/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
