<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           prefWidth="1280"
           prefHeight="720"
           styleClass="root-shell"
           stylesheets="@../css/dashboard.css, @../css/style.css">

    <!-- AURORA BACKGROUND -->
    <Circle radius="320" layoutX="200" layoutY="200" styleClass="aurora-violet" mouseTransparent="true"/>
    <Circle radius="260" layoutX="1050" layoutY="120" styleClass="aurora-indigo" mouseTransparent="true"/>
    <Circle radius="220" layoutX="700" layoutY="620" styleClass="aurora-cyan" mouseTransparent="true"/>

    <HBox>

        <!-- SIDEBAR -->
        <VBox styleClass="sidebar" spacing="10">

            <Label text="OptiFlow" styleClass="logo-name" />

            <VBox spacing="8">
                <HBox styleClass="nav-item nav-active">
                    <Label text="Dashboard" styleClass="nav-label"/>
                </HBox>

                <HBox styleClass="nav-item">
                    <Label text="Tasks" styleClass="nav-label"/>
                </HBox>

                <HBox styleClass="nav-item">
                    <Label text="Analytics" styleClass="nav-label"/>
                </HBox>

                <HBox styleClass="nav-item">
                    <Label text="Settings" styleClass="nav-label"/>
                </HBox>
            </VBox>

        </VBox>

        <!-- MAIN AREA -->
        <VBox styleClass="main-area" VBox.vgrow="ALWAYS">

            <!-- TOP HEADER -->
            <HBox styleClass="top-header" alignment="CENTER_LEFT" spacing="20">
                <VBox>
                    <Label text="Dashboard" styleClass="page-title"/>
                    <Label text="Welcome back 👋" styleClass="page-sub"/>
                </VBox>
            </HBox>

            <!-- CONTENT -->
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">

                <VBox styleClass="content-body" spacing="20">

                    <!-- KPI CARDS -->
                    <HBox spacing="20">
                        <VBox styleClass="kpi-card" prefWidth="200">
                            <Label text="Total Tasks" styleClass="kpi-label"/>
                            <Label text="124" styleClass="kpi-value"/>
                        </VBox>

                        <VBox styleClass="kpi-card" prefWidth="200">
                            <Label text="Completed" styleClass="kpi-label"/>
                            <Label text="98" styleClass="kpi-value"/>
                        </VBox>

                        <VBox styleClass="kpi-card" prefWidth="200">
                            <Label text="Pending" styleClass="kpi-label"/>
                            <Label text="26" styleClass="kpi-value"/>
                        </VBox>
                    </HBox>

                    <!-- PANEL -->
                    <VBox styleClass="panel" spacing="10">
                        <Label text="Recent Activity" styleClass="panel-title"/>
                        <Label text="No recent updates..." styleClass="page-sub"/>
                    </VBox>

                </VBox>

            </ScrollPane>

        </VBox>

    </HBox>

</StackPane>