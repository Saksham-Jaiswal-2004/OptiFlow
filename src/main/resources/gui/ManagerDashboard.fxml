<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root"
    xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.optiflow.controllers.ManagerDashboardController"
      spacing="18"
      styleClass="mgr-root"
      stylesheets="@../css/style.css">

    <VBox spacing="4">
        <Label text="Team Dashboard" styleClass="mgr-title"/>
        <Label text="Overview of team performance and tasks" styleClass="mgr-subtitle"/>
    </VBox>

    <VBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="mgr-card" VBox.vgrow="ALWAYS">
            <Label text="Team Overview" styleClass="mgr-card-title"/>
            <TableView fx:id="teamTable" styleClass="mgr-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="memberNameColumn" text="Name" prefWidth="180"/>
                    <TableColumn fx:id="memberRoleColumn" text="Role" prefWidth="160"/>
                    <TableColumn fx:id="tasksAssignedColumn" text="Tasks Assigned" prefWidth="130"/>
                    <TableColumn fx:id="tasksCompletedColumn" text="Completed" prefWidth="120"/>
                    <TableColumn fx:id="workloadColumn" text="Workload" prefWidth="230"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="12" styleClass="mgr-card" VBox.vgrow="ALWAYS">
            <Label text="Task Tracking" styleClass="mgr-card-title"/>
            <TableView fx:id="taskTable" styleClass="mgr-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="taskIdColumn" text="Task ID" prefWidth="110"/>
                    <TableColumn fx:id="taskNameColumn" text="Task" prefWidth="220"/>
                    <TableColumn fx:id="taskDescriptionColumn" text="Description" prefWidth="260"/>
                    <TableColumn fx:id="taskAssignedToColumn" text="Assigned To" prefWidth="150"/>
                    <TableColumn fx:id="taskStatusColumn" text="Status" prefWidth="120"/>
                    <TableColumn fx:id="taskDeadlineColumn" text="Deadline" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="12" styleClass="mgr-card" VBox.vgrow="ALWAYS">
            <Label text="Weekly Gantt" styleClass="mgr-card-title"/>
            <VBox fx:id="ganttContainer" spacing="8" VBox.vgrow="ALWAYS" styleClass="mgr-gantt-wrap"/>
        </VBox>

        <VBox spacing="12" styleClass="mgr-card" VBox.vgrow="ALWAYS">
            <Label text="Performance Analytics" styleClass="mgr-card-title"/>
            <BarChart fx:id="performanceBarChart" prefHeight="220" styleClass="mgr-bar-chart">
                <xAxis>
                    <CategoryAxis/>
                </xAxis>
                <yAxis>
                    <NumberAxis/>
                </yAxis>
            </BarChart>
            <PieChart fx:id="completionPieChart" labelsVisible="false" legendVisible="true" prefHeight="180" styleClass="mgr-pie-chart"/>
        </VBox>
    </VBox>
</VBox>
