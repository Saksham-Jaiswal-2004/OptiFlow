<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.optiflow.controllers.TaskDetailPanelController"
      spacing="14"
      styleClass="mgr-root"
      prefWidth="1120"
      prefHeight="780"
      stylesheets="@../css/style.css">

    <VBox spacing="3">
        <Label fx:id="pageTitleLabel" text="Task Detail" styleClass="mgr-title"/>
        <Label text="Review assignment, status, and collaboration updates" styleClass="mgr-subtitle"/>
    </VBox>

    <VBox spacing="12" styleClass="mgr-card" opacity="0.98">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Task Overview" styleClass="mgr-card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="dueDateLabel" text="Due: --" styleClass="proj-page-text"/>
        </HBox>

        <Label fx:id="taskDescriptionLabel" text="No task selected." styleClass="dash-card-sub" wrapText="true"/>
    </VBox>

    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <VBox spacing="12" styleClass="mgr-card" HBox.hgrow="ALWAYS" opacity="0.98">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Assigned Employees" styleClass="mgr-card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="memberCountLabel" text="0 members" styleClass="proj-page-text"/>
            </HBox>

            <ListView fx:id="assignedEmployeesList" styleClass="emp-list" VBox.vgrow="ALWAYS" prefHeight="280"/>

            <VBox spacing="6">
                <Label text="Status" styleClass="field-lbl"/>
                <ComboBox fx:id="statusComboBox" promptText="Update status" styleClass="glass-field proj-filter" maxWidth="Infinity"/>
            </VBox>
        </VBox>

        <VBox spacing="12" styleClass="mgr-card" prefWidth="360" opacity="0.98">
            <Label text="Task Actions" styleClass="mgr-card-title"/>

            <VBox spacing="8" styleClass="emp-comment-row">
                <Label text="Execution Note" styleClass="proj-page-text"/>
                <Label text="Break this work into deliverables and close each milestone with a short status update." styleClass="dash-card-sub" wrapText="true"/>
            </VBox>

            <VBox spacing="8" styleClass="emp-comment-row">
                <Label text="Coordination" styleClass="proj-page-text"/>
                <Label text="Use comments below to track blockers and share dependency updates between members." styleClass="dash-card-sub" wrapText="true"/>
            </VBox>

            <Button text="Save Changes" styleClass="glass-btn" maxWidth="Infinity" onAction="#handleSaveChanges"/>
        </VBox>
    </HBox>

    <VBox spacing="10" styleClass="mgr-card" opacity="0.98" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Comments" styleClass="mgr-card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="commentCountLabel" text="0 messages" styleClass="proj-page-text"/>
        </HBox>

        <ListView fx:id="commentsListView" styleClass="emp-list" VBox.vgrow="ALWAYS" prefHeight="300"/>

        <Separator styleClass="dash-separator"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextArea fx:id="commentInputArea" promptText="Write a comment..." styleClass="glass-field" prefRowCount="2" HBox.hgrow="ALWAYS"/>
            <Button text="Post" styleClass="proj-ghost-btn" onAction="#handlePostComment"/>
        </HBox>
    </VBox>
</VBox>
